{
  "buildCommand": "python3 ../scripts/build_release.py --out dist",
  "outputDirectory": "dist",
  "installCommand": "echo skip",
  "cleanUrls": true,
  "headers": [
    { "source": "/downloads/(.*)", "headers": [
      { "key": "Content-Disposition", "value": "attachment" },
      { "key": "Cache-Control", "value": "public, max-age=300" } ] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "Content-Security-Policy",
        "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" } ] }
  ]
}
