# Budly — copy to .env and fill in what you need.
# Only the Canvas section is required. Everything else is optional.

# --- Canvas (required) ----------------------------------------------------------
# The same address you see in the browser; no /api/v1 needed.
CANVAS_BASE_URL=https://canvas.ualberta.ca
# Your personal access token: Canvas, Account, Settings, Approved Integrations,
# New Access Token. Not your Canvas password. Keep it private.
CANVAS_TOKEN=
# Which term to track. Must match Canvas exactly (see `budly doctor`).
CANVAS_TERM=Fall Term 2026
# Minutes between background syncs while Budly runs.
CANVAS_SYNC_INTERVAL_MINUTES=30

# --- Your timezone ---------------------------------------------------------------
# Defaults to this machine's timezone when left empty.
USER_TIMEZONE=
USER_NAME=

# --- AI provider (optional; deterministic answers work without it) ----------------
# Budly walks the chain in order: OpenRouter models, then Groq, then structured
# answers from your own data. Free tiers stack, so one busy provider never
# leaves you without an answer.
OPENROUTER_API_KEY=
# Free slugs rotate; pick current :free models that list tool support.
CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
AI_FALLBACK_MODEL_1=
AI_FALLBACK_MODEL_2=
# Groq (free tier, OpenAI-compatible). Added to the chain when the key is set.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Telegram (optional) ----------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Slack (optional) -------------------------------------------------------------
SLACK_WEBHOOK_URL=

# --- Local development without a Canvas account ------------------------------------
# Three built-in demo courses (CSC 153, COMP 214, MATH 120). The dashboard shows a
# Demo data badge. Never leave this on in daily use.
CANVAS_MOCK_MODE=false

# --- Legacy hosted webhook (optional; NOT needed for local use) --------------------
# Only used by the optional Vercel deployment that receives Telegram webhooks.
WEBHOOK_SECRET=
CRON_SECRET=
# Postgres DSN to store data there instead of the local SQLite file.
DATABASE_URL=
