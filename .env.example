# StudyBuddy — copy to .env then run: canvasbuddy setup
# SETUP.md explains where each value comes from. Never commit .env.

# --- Required -------------------------------------------------------------------
CANVAS_BASE_URL=https://canvas.ualberta.ca
CANVAS_TOKEN=
CANVAS_TERM=Fall Term 2026
# Local development without a Canvas account: CANVAS_MOCK_MODE=true serves three
# built-in fixture courses instead of calling Canvas. Never enable in production.
CANVAS_MOCK_MODE=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
USER_TIMEZONE=America/Edmonton
# Supabase → Connect → Session pooler (port 5432, *.pooler.supabase.com).
# Percent-encode special chars in the password. Example:
# DATABASE_URL=postgresql://postgres.xxx:your-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres?ssl=require
DATABASE_URL=
USER_NAME=Mir

# --- Recommended: lets you ask questions in plain English ------------------------
OPENROUTER_API_KEY=

# --- Notifier schedule (empty = disable that role) -------------------------------
DIGEST_SLOT=daily@07:00
NUDGE_SLOT=daily@20:00
REVIEW_SLOT=sat@08:00
CHECKIN_SLOT=sat@15:00
NOTIFY_GRACE_MINUTES=180
REVIEW_REPLACES_DAILY=true
REVIEW_LOOKBACK_DAYS=7
REVIEW_LOOKAHEAD_DAYS=7

# --- Serverless (Vercel) ----------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(24))"
WEBHOOK_SECRET=
CRON_SECRET=
# Optional: Slack Incoming Webhook URL (api.slack.com/apps → Incoming Webhooks)
SLACK_WEBHOOK_URL=

# --- Optional -------------------------------------------------------------------
DIGEST_HOUR=7
NUDGE_HOUR=20
SHOW_GRADES_IN_DIGEST=false
CHAT_MODEL=anthropic/claude-sonnet-5
EXTRACTION_MODEL=anthropic/claude-opus-5
TRANSCRIPTION_MODEL=google/gemini-2.5-flash-lite

# --- Web dashboard ---------------------------------------------------------------
# The password that unlocks the dashboard chat on your deployment. Leave empty to
# keep the dashboard locked. Any long random string works.
DASHBOARD_PASSWORD=
# Signs the dashboard session cookie. Falls back to CRON_SECRET if left empty.
APP_SECRET=
